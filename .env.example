# Copy this file to ".env" in the project root and fill in your key.
# Both server/ and client/ read from this single file.

# --- Server (backend) --------------------------------------------------
# Required. Never commit your real key.
ANTHROPIC_API_KEY=your-api-key-here

# Optional — defaults shown.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# --- Client (frontend) --------------------------------------------------
# Optional — defaults to this value if omitted. Vite only exposes
# variables prefixed with VITE_ to the browser.
VITE_API_BASE=http://localhost:3001
